# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Your Stripe Secret Key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# VITE_STRIPE_PUBLISHABLE_KEY: Your Stripe Publishable Key (pk_live_... or pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# SWISH HANDEL (Production Swedish Bank Integration)
# In development/test mode, VenueEat uses the built-in simulated sandbox automatically.
# To process real Swish payments with your Swedish corporate bank account (SEB, Swedbank, Handelsbanken, Nordea, etc.):
# 1. Sign a "Swish Handel" agreement with your Swedish bank.
# 2. Generate client TLS certificate & private key in Swish Certificate Management Portal.
# 3. Base64-encode the client certificate (.pem/.crt) and private key (.key).
SWISH_ENVIRONMENT="test" # "test" for BankID sandbox (mss.cpc.getswish.net), "production" for live
SWISH_MERCHANT_NUMBER="1234567890" # Your 10-digit Swish corporate number (starting with 123)
SWISH_CLIENT_CERT_BASE64="" # Base64-encoded client certificate (.pem or .crt)
SWISH_CLIENT_KEY_BASE64="" # Base64-encoded client private key (.key)
SWISH_CALLBACK_URL="" # HTTPS URL for Swish payment status webhook (e.g., https://your-domain.com/api/swish-callback)

# EMAIL NOTIFICATIONS (Automated Event Admin Access Invitations)
# Optional: Get a free API key at https://resend.com (3,000 free emails/month).
# If omitted, VenueEat opens your default Email Client (Gmail/Outlook) with 1-click pre-filled credentials.
RESEND_API_KEY=""
EMAIL_FROM="VenueEat Onboarding <onboarding@resend.dev>"

